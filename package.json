{
  "name": "pi-bluebook-id",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:content": "node scripts/check-content.mjs",
    "check:releases": "node scripts/check-pi-releases.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:pages": "node scripts/check-built-pages.mjs",
    "sync:pi-releases": "node scripts/sync-pi-releases.mjs",
    "check": "npm run check:content && npm run check:consistency && npm run docs:build && npm run check:seo && npm run check:pages && npm run check:i18n",
    "deploy": "npm run check && npx --yes vercel --prod",
    "check:consistency": "node scripts/check-consistency.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "deploy:preview": "npm run check && npx --yes vercel"
  },
  "devDependencies": {
    "minisearch": "7.2.0",
    "vitepress": "1.6.4"
  },
  "description": "Pi Bluebook edisi Bahasa Indonesia: jalur belajar Pi Coding Agent dari instalasi sampai alur kerja agent jangka panjang."
}
